# 🔑 구루! 이종목 진단해줘 환경설정 가이드 (Production & Local)

# 1. Google Gemini AI API 키 (구루 실시간 상담 & AI 선고문 생성)
# 발급: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# 2. 토스증권 / 한국투자증권 OpenAPI 키 (선택 사항: 미입력 시 고정밀 KRX 팩트체크 내장 데이터로 자동 구동)
VITE_TOSS_API_KEY=
VITE_TOSS_SECRET=

# 3. Firebase 배포 설정 (선택 사항: 배포 시 자동 연결)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
